{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tomestack.local/schemas/content-revision.v11.schema.json",
  "title": "TomeStack content revision (schemaVersion 11)",
  "description": "One immutable revision of a content entity (ADR-002) with typed declarative effects (ADR-003). v7 (M3 C3) adds spellcasting.multiclassCaster (full, half or third: how the caster's levels count toward the Multiclass Spellcaster table); v2 to v6 revisions keep their version. v6 (M3 B2) adds the toggle effect, modifier.toggle (whileActive modifiers that apply while a toggle is on), and roll resourceContent (a shared resource), cost and variableCost; v2 to v5 revisions keep their version. v5 (M2, D04) adds the spellcasting, spell and weapon effects, the spell fields (spellAttack, spellSaveDc, spellSlots.1-9, pactSlots), weapon proficiency grants (weapon.*), onlyAs on grants and choices, multiclass and group on restrictions, and activation on rolls; v2 to v4 revisions keep their version. v4 (M2 items 4 and 5) adds the armor effect and extendsChoice: the revision is an extra option of another content's choice. v3 added level-gated grants and choices, the hitDie effect, and the armorClass and hitPoints fields. v2 and v3 revisions keep their version (not upcast). Unknown properties round-trip. An effect whose type is not listed here is kept and is reference-only. v8 (M2.2, the Fighter): the attacks and criticalRange fields, armor training grants (armor.light, armor.medium, armor.heavy, armor.shield), armor strength and stealthDisadvantage, modifier whileArmored and roll bonus. v9 (M5, ADR-010): the scale effect (a named 20-row column of a class or subclass), the formula identifier SCALE.<scaleId> (read only in a v9 revision), and spellcasting.multiclassCasterTable (20 caster-level contributions, never with multiclassCaster or Pact Magic). v9 also allows a choice with no declared options (it offers only published content that extends it, such as a new class's subclass choice; v8 validation refused it). v10 (Wave 3, D42): content may target speed and passive.perception, passive.insight and passive.investigation (modifiers and restrictions); toggle.autoWhen (bloodied) and toggle.activation; resource.activation; the grant kinds damageResistance, damageImmunity and damageVulnerability with grant.damageType (a damage type in any case, stored as written; no target or content on these kinds, and damageType on no other kind); and the item effect (requiresAttunement and charges, on item content, at most one). Each is read only in a v10 revision: in an older revision a toggle, resource or grant key stays an unknown property and does nothing, and an item effect or a damage-defence grant stays an unknown effect, all kept byte for byte. v11 (play mechanics, D43): the toggleGroup effect (a form group a feature declares) and the toggle fields group, groupContent, layer (primary or overlay), allowedWith, allowedInBase, cost (a formula), resourceContent and level. Each is read only in a v11 revision: in an older revision a toggle key stays an unknown property and a toggleGroup stays an unknown effect, all kept byte for byte.",
  "type": "object",
  "required": [
    "contentId",
    "revisionId",
    "schemaVersion",
    "kind",
    "name",
    "rulesFamilies",
    "provenance",
    "status"
  ],
  "properties": {
    "contentId": {
      "$ref": "#/$defs/uuid"
    },
    "revisionId": {
      "$ref": "#/$defs/uuid"
    },
    "schemaVersion": {
      "const": 11
    },
    "extendsChoice": {
      "description": "This revision is also an option of the choice choiceId offered by any revision of contentId (for example a homebrew subclass for an SRD class).",
      "type": "object",
      "required": [
        "contentId",
        "choiceId"
      ],
      "additionalProperties": false,
      "properties": {
        "contentId": {
          "$ref": "#/$defs/uuid"
        },
        "choiceId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "kind": {
      "enum": [
        "species",
        "background",
        "class",
        "subclass",
        "feature",
        "feat",
        "spell",
        "item"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "rulesFamilies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/rulesFamily"
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "sourceId"
      ],
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "$ref": "#/$defs/uuid"
        },
        "page": {
          "$ref": "#/$defs/pageRef"
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "published"
      ]
    },
    "summary": {
      "type": "string"
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "rulesFamily": {
      "enum": [
        "srd-5.1",
        "srd-5.2.1"
      ]
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "description": "Applies from this class level (class content and content belonging to a class) or character level (anything else)."
    },
    "pageRef": {
      "type": "object",
      "required": [
        "start"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "contentReference": {
      "type": "object",
      "required": [
        "contentId",
        "revisionId"
      ],
      "additionalProperties": false,
      "properties": {
        "contentId": {
          "$ref": "#/$defs/uuid"
        },
        "revisionId": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "formula": {
      "type": "string",
      "maxLength": 200,
      "description": "Bounded formula (ADR-003 grammar), e.g. \"2\", \"PB + CON.MOD\", \"floor(CLASS_LEVEL / 2)\"; since v9 also \"SCALE.ink\"."
    },
    "fieldId": {
      "type": "string",
      "pattern": "^(initiative|attacks|criticalRange|proficiencyBonus|armorClass|hitPoints|spellAttack|spellSaveDc|pactSlots|speed|passive\\.(perception|insight|investigation)|spellSlots\\.[1-9]|ability\\.(str|dex|con|int|wis|cha)\\.(score|mod)|save\\.(str|dex|con|int|wis|cha)|skill\\.[a-z][a-zA-Z]*|resource\\.[^\\s.]+)$",
      "description": "Content v11 (D43): resource.<id> names a resource of the same revision; only a modifier uses it (the validator refuses it elsewhere)."
    },
    "grantFieldId": {
      "type": "string",
      "pattern": "^(initiative|attacks|criticalRange|proficiencyBonus|armorClass|hitPoints|spellAttack|spellSaveDc|pactSlots|spellSlots\\.[1-9]|ability\\.(str|dex|con|int|wis|cha)\\.(score|mod)|save\\.(str|dex|con|int|wis|cha)|skill\\.[a-z][a-zA-Z]*)$",
      "description": "The fields a grant may name: the v9 list. speed and passive.* are modifier and restriction targets only; the validator refuses a grant on them."
    },
    "common": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "automation": {
          "enum": [
            "automatic",
            "assisted",
            "reference"
          ]
        },
        "timing": {
          "enum": [
            "always",
            "whileActive",
            "onRoll",
            "onShortRest",
            "onLongRest"
          ]
        },
        "text": {
          "type": "string"
        }
      }
    },
    "effect": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        }
      ],
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "modifier"
            },
            "operation": {
              "enum": [
                "bonus",
                "set",
                "replace"
              ]
            },
            "target": {
              "$ref": "#/$defs/fieldId"
            },
            "value": {
              "$ref": "#/$defs/formula"
            },
            "stacking": {
              "enum": [
                "stack",
                "highestInGroup"
              ]
            },
            "stackGroup": {
              "type": "string",
              "minLength": 1
            },
            "toggle": {
              "type": "string",
              "minLength": 1,
              "description": "Content v6: the toggle of this revision that switches this whileActive modifier on."
            },
            "toggleContent": {
              "$ref": "#/$defs/uuid",
              "description": "Content v11 (D43): the content entry that declares the toggle; absent means this revision."
            },
            "whileArmored": {
              "type": "boolean"
            }
          },
          "required": [
            "operation",
            "target",
            "value"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "grant"
            },
            "grant": {
              "enum": [
                "proficiency",
                "expertise",
                "content",
                "damageResistance",
                "damageImmunity",
                "damageVulnerability"
              ]
            },
            "damageType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "description": "Content v10 (D42): with damageResistance, damageImmunity or damageVulnerability, one of acid, bludgeoning, cold, fire, force, lightning, necrotic, piercing, poison, psychic, radiant, slashing, thunder, in any case (stored as written). Refused on every other grant kind."
            },
            "target": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/grantFieldId"
                    },
                    {
                      "type": "string",
                      "pattern": "^weapon\\.[a-z0-9][a-z0-9-]*$"
                    }
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^armor\\.(light|medium|heavy|shield|none)$"
                }
              ]
            },
            "content": {
              "$ref": "#/$defs/contentReference"
            },
            "level": {
              "$ref": "#/$defs/level"
            },
            "onlyAs": {
              "enum": [
                "startingClass",
                "multiclass"
              ],
              "description": "Content v5 (D04): only as the starting class, or only as a later class."
            }
          },
          "required": [
            "grant"
          ],
          "if": {
            "properties": {
              "grant": {
                "enum": [
                  "damageResistance",
                  "damageImmunity",
                  "damageVulnerability"
                ]
              }
            }
          },
          "then": {
            "required": [
              "damageType"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "target"
                  ]
                },
                {
                  "required": [
                    "content"
                  ]
                }
              ]
            }
          },
          "else": {
            "not": {
              "required": [
                "damageType"
              ]
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "resource"
            },
            "resourceId": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "maximum": {
              "$ref": "#/$defs/formula"
            },
            "activation": {
              "enum": [
                "action",
                "bonusAction",
                "reaction",
                "other"
              ],
              "description": "Content v10 (D42): the kind of action that spends this resource, for grouping on the sheet. Display only."
            },
            "counts": {
              "enum": [
                "up"
              ],
              "description": "Content v11 (D43): the pool counts up from zero to its maximum (built up) instead of down. Absent: counts down."
            },
            "resourceFull": {
              "type": "object",
              "required": [
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "description": "Content v11 (D43): what the sheet says when a counting-up pool is full. Only with counts up."
            },
            "allowance": {
              "type": "boolean",
              "description": "Content v11 (D43): a per-turn allowance (for example one reaction) that an upkeep regain refreshes."
            }
          },
          "required": [
            "resourceId",
            "label",
            "maximum"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "choice"
            },
            "choiceId": {
              "type": "string",
              "minLength": 1
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "options": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/contentReference"
              }
            },
            "level": {
              "$ref": "#/$defs/level"
            },
            "onlyAs": {
              "enum": [
                "startingClass",
                "multiclass"
              ],
              "description": "Content v5 (D04): only as the starting class, or only as a later class."
            }
          },
          "required": [
            "choiceId"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "restriction"
            },
            "field": {
              "$ref": "#/$defs/fieldId"
            },
            "minimum": {
              "type": "integer"
            },
            "multiclass": {
              "type": "boolean",
              "description": "Content v5 (D04): a multiclass prerequisite."
            },
            "group": {
              "type": "string",
              "minLength": 1,
              "description": "Content v5: restrictions with the same group are alternatives."
            }
          },
          "required": [
            "field",
            "minimum"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "recovery"
            },
            "resourceId": {
              "type": "string",
              "minLength": 1
            },
            "on": {
              "enum": [
                "shortRest",
                "longRest"
              ]
            },
            "amount": {
              "$ref": "#/$defs/formula"
            }
          },
          "required": [
            "resourceId",
            "on",
            "amount"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "roll"
            },
            "rollId": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "dice": {
              "type": "string",
              "maxLength": 40
            },
            "resourceId": {
              "type": "string"
            },
            "activation": {
              "enum": [
                "action",
                "bonusAction",
                "reaction",
                "other"
              ]
            },
            "resourceContent": {
              "$ref": "#/$defs/uuid",
              "description": "Content v6: the content id that defines resourceId (a shared resource)."
            },
            "cost": {
              "$ref": "#/$defs/formula",
              "description": "Content v6: uses spent (default 1), or the most with variableCost."
            },
            "variableCost": {
              "type": "boolean"
            },
            "bonus": {
              "$ref": "#/$defs/formula"
            },
            "whileToggle": {
              "type": "object",
              "required": [
                "toggleId"
              ],
              "properties": {
                "contentId": {
                  "$ref": "#/$defs/uuid"
                },
                "toggleId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "description": "Content v11 (D43): the roll is offered only while this toggle is on (it may be another content's)."
            }
          },
          "required": [
            "rollId",
            "label",
            "dice"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "hitDie"
            },
            "die": {
              "enum": [
                6,
                8,
                10,
                12
              ]
            }
          },
          "required": [
            "die"
          ]
        },
        {
          "description": "M2 item 4: body armor (light, medium, heavy) or a shield on an item. Content v4 only (ADR-003): in a v2 or v3 revision an armor effect is unknown and reference-only, kept byte for byte, so revisions stored by 0.2.0 keep their hash and meaning.",
          "properties": {
            "type": {
              "const": "armor"
            },
            "category": {
              "enum": [
                "light",
                "medium",
                "heavy",
                "shield"
              ]
            },
            "armorClass": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30
            },
            "dexterityCap": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "strength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "stealthDisadvantage": {
              "type": "boolean"
            }
          },
          "required": [
            "category",
            "armorClass"
          ]
        },
        {
          "description": "Content v5: a class's (or subclass's) Spellcasting. Tables are indexed by the level in the class (row 0 = level 1). Spell attack = PB + the ability modifier; save DC = 8 + PB + the ability modifier.",
          "properties": {
            "type": {
              "const": "spellcasting"
            },
            "ability": {
              "enum": [
                "str",
                "dex",
                "con",
                "int",
                "wis",
                "cha"
              ]
            },
            "preparation": {
              "enum": [
                "prepared",
                "known"
              ]
            },
            "spellList": {
              "type": "string",
              "minLength": 1
            },
            "slotKind": {
              "enum": [
                "spellSlots",
                "pactMagic"
              ]
            },
            "slots": {
              "type": "array",
              "minItems": 20,
              "maxItems": 20,
              "items": {
                "type": "array",
                "maxItems": 9,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            },
            "cantrips": {
              "type": "array",
              "minItems": 20,
              "maxItems": 20,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            },
            "spellsTable": {
              "type": "array",
              "minItems": 20,
              "maxItems": 20,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            },
            "spellsFormula": {
              "$ref": "#/$defs/formula"
            },
            "multiclassCaster": {
              "enum": [
                "full",
                "half",
                "third"
              ],
              "description": "Content v7 (M3 C3): how this caster's class levels count toward the Multiclass Spellcaster table (all, half or a third; the rounding is rules-family policy). Absent: not combined. Ordinary spell slots only."
            },
            "multiclassCasterTable": {
              "type": "array",
              "minItems": 20,
              "maxItems": 20,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20
              },
              "description": "Content v9 (ADR-010): the caster levels this class adds to the Multiclass Spellcaster table at each class level (at most the class level, never decreasing). Exact numbers, no rules-family rounding. Not with multiclassCaster; ordinary spell slots only."
            }
          },
          "required": [
            "ability",
            "spellList",
            "slots"
          ]
        },
        {
          "description": "Content v5: the game data of a spell (on spell content). Never active content.",
          "properties": {
            "type": {
              "const": "spell"
            },
            "level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "school": {
              "type": "string"
            },
            "castingTime": {
              "type": "string"
            },
            "range": {
              "type": "string"
            },
            "components": {
              "type": "string"
            },
            "duration": {
              "type": "string"
            },
            "concentration": {
              "type": "boolean"
            },
            "ritual": {
              "type": "boolean"
            },
            "lists": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "attack": {
              "enum": [
                "none",
                "melee",
                "ranged"
              ]
            },
            "save": {
              "anyOf": [
                {
                  "enum": [
                    "str",
                    "dex",
                    "con",
                    "int",
                    "wis",
                    "cha"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "dice": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "level"
          ]
        },
        {
          "description": "Content v5: a weapon on an item; an equipped one gives an attack (SPEC C-02, C-04).",
          "properties": {
            "type": {
              "const": "weapon"
            },
            "category": {
              "enum": [
                "simple",
                "martial"
              ]
            },
            "attack": {
              "enum": [
                "melee",
                "ranged"
              ]
            },
            "damage": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "damageType": {
              "type": "string",
              "minLength": 1
            },
            "properties": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "versatile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "range": {
              "type": "string"
            },
            "weaponKey": {
              "type": "string",
              "minLength": 1
            },
            "mastery": {
              "type": "string"
            }
          },
          "required": [
            "category",
            "attack",
            "damage",
            "damageType",
            "weaponKey"
          ]
        },
        {
          "description": "Content v6 (M3 B2): something switched on and off at the table; modifiers naming it apply while it is on. Turning it on can spend one use of a resource of this revision.",
          "properties": {
            "type": {
              "const": "toggle"
            },
            "toggleId": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "resourceId": {
              "type": "string",
              "minLength": 1
            },
            "autoWhen": {
              "enum": [
                "bloodied"
              ],
              "description": "Content v10 (D42): the toggle switches itself from play state while the condition holds. Computed, never stored."
            },
            "activation": {
              "enum": [
                "action",
                "bonusAction",
                "reaction",
                "other"
              ],
              "description": "Content v10 (D42): the kind of action that switches the toggle, for grouping on the sheet. Display only."
            },
            "group": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9]{0,31}$",
              "description": "Content v11 (D43): the form group (a toggleGroup groupId) this toggle belongs to."
            },
            "groupContent": {
              "$ref": "#/$defs/uuid",
              "description": "Content v11 (D43): the content that declares the group; it may be another source's. Absent: this revision."
            },
            "layer": {
              "enum": [
                "primary",
                "overlay"
              ],
              "description": "Content v11 (D43): a form (primary, the default) or an overlay on a form."
            },
            "allowedWith": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "toggleId"
                ],
                "additionalProperties": false,
                "properties": {
                  "contentId": {
                    "$ref": "#/$defs/uuid"
                  },
                  "toggleId": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "description": "Content v11 (D43): the primaries an overlay may be on with."
            },
            "allowedInBase": {
              "type": "boolean",
