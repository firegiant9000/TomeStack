{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tomestack.local/schemas/package-manifest.v7.schema.json",
  "title": "TomeStack package manifest (formatVersion 7)",
  "description": "manifest.json of a *.tomestack.zip package (SPEC P-02; docs/features/package-format.md). v7 (M6 slice 1; the number is settled on the M5+M6 integration branch and final only when it merges to main) adds scope 'source': a source pack, always purpose 'share', with only sources/ and content/ entries (published revisions only), revisionOrder and attestations (the sender's statement that each source is their own work). Library backups are written as v7 too, because their sources/ entries may carry importDerived, origin and shareConfirmedAt (source.v2.schema.json). Character packages are still written as v5. v6 added scope 'library'; v5 gaps/; v4 campaigns/; v3 purpose and omitted (ADR-007).",
  "type": "object",
  "required": ["format", "formatVersion", "createdAt", "appVersion", "purpose", "characters", "entries", "notices", "omitted", "attachmentPolicy"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "tomestack.package" },
    "formatVersion": { "const": 7 },
    "createdAt": { "type": "string", "format": "date-time" },
    "appVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "purpose": { "enum": ["backup", "share"] },
    "scope": { "enum": ["characters", "library", "source"] },
    "characters": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
    "revisionOrder": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
    "attestations": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["sourceId", "statement", "confirmedAt"],
        "additionalProperties": false,
        "properties": {
          "sourceId": { "$ref": "#/$defs/uuid" },
          "statement": { "type": "string" },
          "confirmedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "entries": {
      "type": "array",
      "maxItems": 200000,
      "items": {
        "type": "object",
        "required": ["path", "kind", "sha256", "size"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^((sources|content|characters|campaigns|gaps|attachments)/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.json|files/[0-9a-f]{64}\\.pdf)$"
          },
          "kind": { "enum": ["source", "contentRevision", "character", "campaign", "gapNote", "attachment", "pdf"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 0, "maximum": 1073741824 }
        }
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "title", "publisher", "license", "redistributable"],
        "additionalProperties": false,
        "properties": {
          "sourceId": { "$ref": "#/$defs/uuid" },
          "title": { "type": "string" },
          "publisher": { "type": "string" },
          "license": { "type": "string" },
          "redistributable": { "type": "boolean" },
          "attribution": { "type": "string" },
          "modificationNotice": { "type": "string" }
        }
      }
    },
    "omitted": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "title", "publisher", "license", "revisions"],
        "additionalProperties": false,
        "properties": {
          "sourceId": { "$ref": "#/$defs/uuid" },
          "title": { "type": "string" },
          "publisher": { "type": "string" },
          "license": { "type": "string" },
          "revisions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["reference", "name", "characters"],
              "additionalProperties": false,
              "properties": {
                "reference": {
                  "type": "object",
                  "required": ["contentId", "revisionId"],
                  "additionalProperties": false,
                  "properties": { "contentId": { "$ref": "#/$defs/uuid" }, "revisionId": { "$ref": "#/$defs/uuid" } }
                },
                "name": { "type": "string" },
                "characters": { "type": "array", "items": { "$ref": "#/$defs/uuid" } }
              }
            }
          }
        }
      }
    },
    "attachmentPolicy": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "scope": { "const": "source" } }, "required": ["scope"] },
      "then": {
        "required": ["revisionOrder", "attestations"],
        "properties": {
          "purpose": { "const": "share" },
          "characters": { "maxItems": 0 },
          "omitted": { "maxItems": 0 },
          "entries": { "items": { "properties": { "path": { "pattern": "^(sources|content)/" } } } }
        }
      }
    }
  ],
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
  }
}
