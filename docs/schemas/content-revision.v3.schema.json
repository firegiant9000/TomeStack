{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tomestack.local/schemas/content-revision.v3.schema.json",
  "title": "TomeStack content revision (schemaVersion 3)",
  "description": "One immutable revision of a content entity (ADR-002) with typed declarative effects (ADR-003). v3 adds level-gated grants and the hitDie effect, and the armorClass and hitPoints fields. v2 revisions stay v2 (not upcast). Unknown properties round-trip. An effect whose type is not listed here is kept and is reference-only.",
  "type": "object",
  "required": ["contentId", "revisionId", "schemaVersion", "kind", "name", "rulesFamilies", "provenance", "status"],
  "properties": {
    "contentId": { "$ref": "#/$defs/uuid" },
    "revisionId": { "$ref": "#/$defs/uuid" },
    "schemaVersion": { "const": 3 },
    "kind": { "enum": ["species", "background", "class", "subclass", "feature", "feat", "spell", "item"] },
    "name": { "type": "string", "minLength": 1 },
    "rulesFamilies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/rulesFamily" } },
    "provenance": {
      "type": "object",
      "required": ["sourceId"],
      "additionalProperties": false,
      "properties": {
        "sourceId": { "$ref": "#/$defs/uuid" },
        "page": { "$ref": "#/$defs/pageRef" }
      }
    },
    "status": { "enum": ["draft", "published"] },
    "summary": { "type": "string" },
    "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "rulesFamily": { "enum": ["srd-5.1", "srd-5.2.1"] },
    "level": { "type": "integer", "minimum": 1, "maximum": 20, "description": "Applies from this class level (class content and content belonging to a class) or character level (anything else)." },
    "pageRef": {
      "type": "object",
      "required": ["start"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "integer", "minimum": 1 },
        "end": { "type": "integer", "minimum": 1 }
      }
    },
    "contentReference": {
      "type": "object",
      "required": ["contentId", "revisionId"],
      "additionalProperties": false,
      "properties": { "contentId": { "$ref": "#/$defs/uuid" }, "revisionId": { "$ref": "#/$defs/uuid" } }
    },
    "formula": {
      "type": "string",
      "maxLength": 200,
      "description": "Bounded formula (ADR-003 grammar), e.g. \"2\", \"PB + CON.MOD\", \"floor(CLASS_LEVEL / 2)\"."
    },
    "fieldId": { "type": "string", "pattern": "^(initiative|proficiencyBonus|armorClass|hitPoints|ability\\.(str|dex|con|int|wis|cha)\\.(score|mod)|save\\.(str|dex|con|int|wis|cha)|skill\\.[a-z][a-zA-Z]*)$" },
    "common": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "automation": { "enum": ["automatic", "assisted", "reference"] },
        "timing": { "enum": ["always", "whileActive", "onRoll", "onShortRest", "onLongRest"] },
        "text": { "type": "string" }
      }
    },
    "effect": {
      "allOf": [{ "$ref": "#/$defs/common" }],
      "oneOf": [
        {
          "properties": {
            "type": { "const": "modifier" },
            "operation": { "enum": ["bonus", "set", "replace"] },
            "target": { "$ref": "#/$defs/fieldId" },
            "value": { "$ref": "#/$defs/formula" },
            "stacking": { "enum": ["stack", "highestInGroup"] },
            "stackGroup": { "type": "string", "minLength": 1 }
          },
          "required": ["operation", "target", "value"]
        },
        {
          "properties": {
            "type": { "const": "grant" },
            "grant": { "enum": ["proficiency", "expertise", "content"] },
            "target": { "$ref": "#/$defs/fieldId" },
            "content": { "$ref": "#/$defs/contentReference" },
            "level": { "$ref": "#/$defs/level" }
          },
          "required": ["grant"]
        },
        {
          "properties": {
            "type": { "const": "resource" },
            "resourceId": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "maximum": { "$ref": "#/$defs/formula" }
          },
          "required": ["resourceId", "label", "maximum"]
        },
        {
          "properties": {
            "type": { "const": "choice" },
            "choiceId": { "type": "string", "minLength": 1 },
            "count": { "type": "integer", "minimum": 1, "maximum": 20 },
            "options": { "type": "array", "items": { "$ref": "#/$defs/contentReference" } }
          },
          "required": ["choiceId"]
        },
        {
          "properties": {
            "type": { "const": "restriction" },
            "field": { "$ref": "#/$defs/fieldId" },
            "minimum": { "type": "integer" }
          },
          "required": ["field", "minimum"]
        },
        {
          "properties": {
            "type": { "const": "recovery" },
            "resourceId": { "type": "string", "minLength": 1 },
            "on": { "enum": ["shortRest", "longRest"] },
            "amount": { "$ref": "#/$defs/formula" }
          },
          "required": ["resourceId", "on", "amount"]
        },
        {
          "properties": {
            "type": { "const": "roll" },
            "rollId": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "dice": { "type": "string", "maxLength": 40 },
            "resourceId": { "type": "string" }
          },
          "required": ["rollId", "label", "dice"]
        },
        {
          "properties": {
            "type": { "const": "hitDie" },
            "die": { "enum": [6, 8, 10, 12] }
          },
          "required": ["die"]
        },
        {
          "description": "Unknown effect type: kept, reference-only.",
          "properties": { "type": { "not": { "enum": ["modifier", "grant", "resource", "choice", "restriction", "recovery", "roll", "hitDie"] } } }
        }
      ]
    }
  }
}
