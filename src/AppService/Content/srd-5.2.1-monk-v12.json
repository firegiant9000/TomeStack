    {
      "contentId": "52c00000-0000-4000-8000-000000420102",
      "revisionId": "52e00000-0000-4000-8000-000012420102",
      "schemaVersion": 12,
      "kind": "feature",
      "name": "Unarmored Defense",
      "rulesFamilies": [
        "srd-5.2.1"
      ],
      "provenance": {
        "sourceId": "52500000-0000-4000-8000-000000000001",
        "page": {
          "start": 50
        }
      },
      "status": "published",
      "summary": "While you aren’t wearing armor or wielding a Shield, your base Armor Class equals 10 plus your Dexterity and Wisdom modifiers.\n\nTomeStack: applies only while no armor is worn and no Shield is used (the Armor Class breakdown shows it as not used otherwise).",
      "effects": [
        {
          "type": "modifier",
          "id": "unarmored-defense-ac",
          "operation": "replace",
          "target": "armorClass",
          "value": "10 + DEX.MOD + WIS.MOD",
          "notWearing": [
            "shield"
          ],
          "text": "Applies only while no armor is worn and no Shield is used."
        }
      ]
    },
    {
      "contentId": "52c00000-0000-4000-8000-000000420104",
      "revisionId": "52e00000-0000-4000-8000-000012420104",
      "schemaVersion": 12,
      "kind": "feature",
      "name": "Unarmored Movement",
      "rulesFamilies": [
        "srd-5.2.1"
      ],
      "provenance": {
        "sourceId": "52500000-0000-4000-8000-000000000001",
        "page": {
          "start": 51
        }
      },
      "status": "published",
      "summary": "Your speed increases by 10 feet while you aren’t wearing armor or wielding a Shield. This bonus increases when you reach certain Monk levels, as shown on the Monk Features table.\n\nTomeStack: the bonus from the Unarmored Movement column is added to your Speed only while no armor is worn and no Shield is used.",
      "effects": [
        {
          "type": "modifier",
          "id": "unarmored-movement-speed",
          "operation": "bonus",
          "target": "speed",
          "value": "SCALE.unarmoredMovement",
          "notWearing": [
            "armor",
            "shield"
          ],
          "text": "Not while you wear armor or wield a Shield."
        }
      ]
    },
    {
      "contentId": "52c00000-0000-4000-8000-000000420106",
      "revisionId": "52e00000-0000-4000-8000-000012420106",
      "schemaVersion": 12,
      "kind": "feature",
      "name": "Deflect Attacks",
      "rulesFamilies": [
        "srd-5.2.1"
      ],
      "provenance": {
        "sourceId": "52500000-0000-4000-8000-000000000001",
        "page": {
          "start": 51
        }
      },
      "status": "published",
      "summary": "When an attack roll hits you and its damage includes Bludgeoning, Piercing, or Slashing damage, you can take a Reaction to reduce the attack’s total damage against you. The reduction equals 1d10 plus your Dexterity modifier and Monk level.\n\nIf you reduce the damage to 0, you can expend 1 Focus Point to redirect some of the attack’s force. If you do so, choose a creature you can see within 5 feet of yourself if the attack was a melee attack or a creature you can see within 60 feet of yourself that isn’t behind Total Cover if the attack was a ranged attack. That creature must succeed on a Dexterity saving throw or take damage equal to two rolls of your Martial Arts die plus your Dexterity modifier. The damage is the same type dealt by the attack.\n\nTomeStack: the damage reduction is offered in the damage panel for a hit from an attack that deals Bludgeoning, Piercing, or Slashing damage; you spend your Reaction by hand. The redirect spends 1 Focus Point and shows the Dexterity saving throw DC; the redirected damage is done by hand.",
      "effects": [
        {
          "type": "roll",
          "id": "deflect-attacks-redirect",
          "rollId": "deflectAttacksRedirect",
          "label": "Deflect Attacks: redirect",
          "resourceId": "focus",
          "activation": "reaction",
          "resourceContent": "52c00000-0000-4000-8000-000000420103",
          "cost": "1",
          "save": {
            "ability": "dex",
            "dc": "8 + WIS.MOD + PB"
          }
        },
        {
          "type": "response",
          "id": "deflect-attacks",
          "responseId": "deflectAttacks",
          "label": "Deflect Attacks",
          "phase": "damageReduction",
          "trigger": {
            "from": "attack",
            "damageTypes": [
              "bludgeoning",
              "piercing",
              "slashing"
            ]
          },
          "dice": "1d10",
          "amount": "DEX.MOD + CLASS_LEVEL",
          "text": "You spend your reaction by hand; TomeStack does not track it."
        }
      ]
    },
    {
      "contentId": "52c00000-0000-4000-8000-000000420108",
      "revisionId": "52e00000-0000-4000-8000-000012420108",
      "schemaVersion": 12,
      "kind": "feature",
      "name": "Slow Fall",
      "rulesFamilies": [
        "srd-5.2.1"
      ],
      "provenance": {
        "sourceId": "52500000-0000-4000-8000-000000000001",
        "page": {
          "start": 51
        }
      },
      "status": "published",
      "summary": "You can take a Reaction when you fall to reduce any damage you take from the fall by an amount equal to five times your Monk level.\n\nTomeStack: the reduction is offered in the damage panel for fall damage. You spend your reaction by hand; TomeStack does not track it.",
      "effects": [
        {
          "type": "response",
          "id": "slow-fall",
          "responseId": "slowFall",
          "label": "Slow Fall",
          "phase": "damageReduction",
          "trigger": {
            "from": "fall"
          },
          "amount": "5 * CLASS_LEVEL",
          "text": "You spend your reaction by hand; TomeStack does not track it."
        }
      ]
    },
    {
      "contentId": "52c00000-0000-4000-8000-000000420112",
      "revisionId": "52e00000-0000-4000-8000-000012420112",
      "schemaVersion": 12,
      "kind": "feature",
      "name": "Evasion",
      "rulesFamilies": [
        "srd-5.2.1"
      ],
      "provenance": {
        "sourceId": "52500000-0000-4000-8000-000000000001",
        "page": {
          "start": 51
        }
      },
      "status": "published",
      "summary": "When you’re subjected to an effect that allows you to make a Dexterity saving throw to take only half damage, you instead take no damage if you succeed on the saving throw and only half damage if you fail.\n\nYou don’t benefit from this feature if you have the Incapacitated condition.\n\nTomeStack: offered in the damage panel for a Dexterity saving throw, and off while the Incapacitated condition is marked.",
      "effects": [
        {
          "type": "response",
          "id": "evasion-success",
          "responseId": "evasionSuccess",
          "label": "Evasion",
          "phase": "damageReduction",
          "trigger": {
            "from": "save",
            "ability": "dex",
            "result": "success"
          },
          "share": "all",
          "automatic": true,
          "unlessCondition": "incapacitated"
        },
        {
          "type": "response",
          "id": "evasion-failure",
          "responseId": "evasionFailure",
          "label": "Evasion",
          "phase": "damageReduction",
          "trigger": {
            "from": "save",
            "ability": "dex",
            "result": "failure"
          },
          "share": "half",
          "automatic": true,
          "unlessCondition": "incapacitated"
        }
      ]
    },
    {
      "contentId": "52c00000-0000-4000-8000-000000420116",
      "revisionId": "52e00000-0000-4000-8000-000012420116",
      "schemaVersion": 12,
      "kind": "feature",
      "name": "Deflect Energy",
      "rulesFamilies": [
        "srd-5.2.1"
      ],
      "provenance": {
        "sourceId": "52500000-0000-4000-8000-000000000001",
        "page": {
          "start": 52
        }
      },
      "status": "published",
      "summary": "You can now use your Deflect Attacks feature against attacks that deal any damage type, not just Bludgeoning, Piercing, or Slashing.\n\nTomeStack: this replaces the Deflect Attacks damage reduction in the damage panel with one for any damage type. You spend your reaction by hand; TomeStack does not track it.",
      "effects": [
        {
          "type": "response",
          "id": "deflect-energy",
          "responseId": "deflectEnergy",
          "label": "Deflect Energy",
          "phase": "damageReduction",
          "trigger": {
            "from": "attack"
          },
          "dice": "1d10",
          "amount": "DEX.MOD + CLASS_LEVEL",
          "supersedes": {
            "content": "52c00000-0000-4000-8000-000000420106",
            "responseId": "deflectAttacks"
          },
          "text": "You spend your reaction by hand; TomeStack does not track it."
        }
      ]
    },
    {
