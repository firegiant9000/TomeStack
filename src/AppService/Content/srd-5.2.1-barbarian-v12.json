    {
      "contentId": "52c00000-0000-4000-8000-000000000016",
      "revisionId": "52e00000-0000-4000-8000-000012000016",
      "schemaVersion": 12,
      "kind": "feature",
      "name": "Reckless Attack",
      "rulesFamilies": [
        "srd-5.2.1"
      ],
      "provenance": {
        "sourceId": "52500000-0000-4000-8000-000000000001",
        "page": {
          "start": 29
        }
      },
      "status": "published",
      "summary": "You can throw aside all concern for defense to attack with increased ferocity. When you make your first attack roll on your turn, you can decide to attack recklessly. Doing so gives you Advantage on attack rolls using Strength until the start of your next turn, but attack rolls against you have Advantage during that time.",
      "effects": [
        {
          "type": "toggle",
          "id": "reckless",
          "toggleId": "reckless",
          "label": "Reckless Attack",
          "duration": "1",
          "text": "Turn this on as your first attack roll of the turn; the \"first attack roll on your turn\" condition is by hand. It ends at the start of your next turn in an encounter; outside an encounter, turn it off yourself."
        },
        {
          "type": "rollMode",
          "id": "reckless-attack-advantage",
          "target": "attack",
          "mode": "advantage",
          "tags": [
            "all"
          ],
          "ability": "str",
          "toggle": "reckless"
        },
        {
          "type": "rollMode",
          "id": "reckless-attacks-against",
          "target": "attacksAgainst",
          "mode": "advantage",
          "toggle": "reckless"
        }
      ]
    },
    {
      "contentId": "52c00000-0000-4000-8000-000000409103",
