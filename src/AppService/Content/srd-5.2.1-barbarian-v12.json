    {
      "contentId": "52c00000-0000-4000-8000-000000409501",
      "revisionId": "52e00000-0000-4000-8000-000012409501",
      "schemaVersion": 12,
      "kind": "feature",
      "name": "Mindless Rage",
      "rulesFamilies": [
        "srd-5.2.1"
      ],
      "provenance": {
        "sourceId": "52500000-0000-4000-8000-000000000001",
        "page": {
          "start": 30
        }
      },
      "status": "published",
      "summary": "You have Immunity to the Charmed and Frightened conditions while your Rage is active. If you’re Charmed or Frightened when you enter your Rage, the condition ends on you.",
      "effects": [
        {
          "type": "grant",
          "id": "mindless-rage-charmed",
          "grant": "conditionImmunity",
          "condition": "charmed",
          "whileToggle": {
            "contentId": "52c00000-0000-4000-8000-000000000012",
            "toggleId": "rage"
          },
          "text": "Not Charmed while your Rage is active. Ending a charm you already have is by hand."
        },
        {
          "type": "grant",
          "id": "mindless-rage-frightened",
          "grant": "conditionImmunity",
          "condition": "frightened",
          "whileToggle": {
            "contentId": "52c00000-0000-4000-8000-000000000012",
            "toggleId": "rage"
          },
          "text": "Not Frightened while your Rage is active. Ending a fright you already have is by hand."
