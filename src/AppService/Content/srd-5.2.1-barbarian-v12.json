          "target": "speed",
          "value": "10",
          "notWearing": [
            "heavyArmor"
          ],
          "text": "Not while you wear Heavy armor."
        }
      ]
    },
    {
      "contentId": "52c00000-0000-4000-8000-000000409104",
      "revisionId": "52e00000-0000-4000-8000-000012409104",
      "schemaVersion": 12,
      "kind": "feature",
      "name": "Feral Instinct",
      "rulesFamilies": [
        "srd-5.2.1"
      ],
      "provenance": {
        "sourceId": "52500000-0000-4000-8000-000000000001",
        "page": {
          "start": 29
        }
      },
      "status": "published",
      "summary": "Your instincts are so honed that you have Advantage on Initiative rolls.",
      "effects": [
        {
          "type": "rollMode",
          "id": "feral-instinct-initiative",
          "target": "initiative",
          "mode": "advantage",
          "text": "Advantage on Initiative rolls."
        }
      ]
    },
    {
      "contentId": "52c00000-0000-4000-8000-000000409106",
      "revisionId": "52e00000-0000-4000-8000-000012409106",
      "schemaVersion": 12,
      "kind": "feature",
      "name": "Brutal Strike",
      "rulesFamilies": [
        "srd-5.2.1"
      ],
      "provenance": {
        "sourceId": "52500000-0000-4000-8000-000000000001",
        "page": {
          "start": 29,
          "end": 30
        }
      },
      "status": "published",
      "summary": "If you use Reckless Attack, you can forgo any Advantage on one Strength-based attack roll of your choice on your turn. The chosen attack roll mustn’t have Disadvantage. If the chosen attack roll hits, the target takes an extra 1d10 damage of the same type dealt by the weapon or Unarmed Strike, and you can cause one Brutal Strike effect of your choice. You have the following effect options.\n\nForceful Blow. The target is pushed 15 feet straight away from you. You can then move up to half your Speed straight toward the target without provoking Opportunity Attacks.\n\nHamstring Blow. The target’s Speed is reduced by 15 feet until the start of your next turn. A target can be affected by only one Hamstring Blow at a time—the most recent one.",
      "effects": [
        {
          "type": "attackRider",
          "id": "brutal-strike",
          "tags": [
            "weapon"
          ],
          "oncePerTurn": true,
          "automation": "assisted",
          "scaledDice": {
            "count": "SCALE.brutalStrikeDice",
            "die": "10"
          },
          "text": "Add the extra damage (1d10, 2d10 from 17th level) to the damage roll of the one Strength-based attack you chose. Forgoing Advantage, that the attack is Strength-based, and the Brutal Strike effect options are by hand."
        }
      ]
    },
    {
      "contentId": "52c00000-0000-4000-8000-000000409111",
      "revisionId": "52e00000-0000-4000-8000-000012409111",
      "schemaVersion": 12,
      "kind": "feature",
      "name": "Indomitable Might",
      "rulesFamilies": [
        "srd-5.2.1"
      ],
      "provenance": {
        "sourceId": "52500000-0000-4000-8000-000000000001",
        "page": {
          "start": 30
        }
      },
      "status": "published",
      "summary": "If your total for a Strength check or Strength saving throw is less than your Strength score, you can use that score in place of the total.",
      "effects": [
        {
          "type": "rollFloor",
          "id": "indomitable-might",
          "target": "ability.str.check",
          "total": "STR.SCORE",
          "text": "Strength checks. The same floor on a Strength saving throw is by hand."
        }
      ]
    },
    {
      "contentId": "52c00000-0000-4000-8000-000000409113",
