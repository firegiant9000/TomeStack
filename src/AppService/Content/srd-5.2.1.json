        { "type": "grant", "id": "primal-knowledge", "grant": "content", "level": 3, "content": { "contentId": "52c00000-0000-4000-8000-000000000025", "revisionId": "52e00000-0000-4000-8000-000000000025" } },
        {
          "type": "choice",
          "id": "barbarian-subclass",
          "choiceId": "barbarian-subclass",
