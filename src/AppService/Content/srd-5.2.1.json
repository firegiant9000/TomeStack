    {
      "contentId": "52c00000-0000-4000-8000-000000000010",
      "revisionId": "52e00000-0000-4000-8000-000000000010",
      "schemaVersion": 3,
      "kind": "feat",
      "name": "Savage Attacker",
      "rulesFamilies": ["srd-5.2.1"],
      "provenance": { "sourceId": "52500000-0000-4000-8000-000000000001", "page": { "start": 87 } },
      "status": "published",
      "summary": "Origin Feat. You've trained to deal particularly damaging strikes. Once per turn when you hit a target with a weapon, you can roll the weapon's damage dice twice and use either roll against the target."
    },
    {
      "contentId": "52c00000-0000-4000-8000-000000000011",
      "revisionId": "52e00000-0000-4000-8000-000000000011",
      "schemaVersion": 3,
      "kind": "class",
      "name": "Barbarian",
      "rulesFamilies": ["srd-5.2.1"],
      "provenance": { "sourceId": "52500000-0000-4000-8000-000000000001", "page": { "start": 28, "end": 30 } },
      "status": "published",
      "summary": "Primary Ability: Strength. Hit Point Die: D12 per Barbarian level. Saving Throw Proficiencies: Strength and Constitution. Skill Proficiencies: Choose 2: Animal Handling, Athletics, Intimidation, Nature, Perception, or Survival. Weapon Proficiencies: Simple and Martial weapons. Armor Training: Light and Medium armor and Shields. TomeStack slice: levels 1-3.",
      "effects": [
        { "type": "hitDie", "id": "barbarian-hit-die", "die": 12 },
        { "type": "grant", "id": "barbarian-save-str", "grant": "proficiency", "target": "save.str" },
        { "type": "grant", "id": "barbarian-save-con", "grant": "proficiency", "target": "save.con" },
        {
          "type": "choice",
          "id": "barbarian-skills",
          "choiceId": "barbarian-skills",
          "count": 2,
          "text": "Skill Proficiencies: Choose 2: Animal Handling, Athletics, Intimidation, Nature, Perception, or Survival.",
          "options": [
            { "contentId": "52c00000-0000-4000-8000-000000000017", "revisionId": "52e00000-0000-4000-8000-000000000017" },
            { "contentId": "52c00000-0000-4000-8000-000000000018", "revisionId": "52e00000-0000-4000-8000-000000000018" },
