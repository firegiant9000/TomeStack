    {
      "contentId": "52c00000-0000-4000-8000-000000000012",
      "revisionId": "52e00000-0000-4000-8000-000000000012",
      "schemaVersion": 3,
      "kind": "feature",
      "name": "Rage",
      "rulesFamilies": ["srd-5.2.1"],
      "provenance": { "sourceId": "52500000-0000-4000-8000-000000000001", "page": { "start": 28, "end": 29 } },
      "status": "published",
      "summary": "You can imbue yourself with a primal power called Rage, a force that grants you extraordinary might and resilience. You can enter it as a Bonus Action if you aren't wearing Heavy armor. While active, your Rage follows the rules below. Damage Resistance. You have Resistance to Bludgeoning, Piercing, and Slashing damage. Rage Damage. When you make an attack using Strength (with either a weapon or an Unarmed Strike) and deal damage to the target, you gain a bonus to the damage that increases as you gain levels as a Barbarian, as shown in the Rage Damage column of the Barbarian Features table (+2 at levels 1-3). Strength Advantage. You have Advantage on Strength checks and Strength saving throws. No Concentration or Spells. You can't maintain Concentration, and you can't cast spells.",
      "effects": [
        { "type": "resource", "id": "rages", "resourceId": "rage", "label": "Rages", "maximum": "min(2 + floor(CLASS_LEVEL / 3), 4)", "text": "You can enter your Rage the number of times shown for your Barbarian level in the Rages column: 2 at levels 1-2, 3 at levels 3-5, 4 at levels 6-11. The formula matches the table for levels 1-11." },
        { "type": "recovery", "id": "rages-short-rest", "timing": "onShortRest", "resourceId": "rage", "on": "shortRest", "amount": "1", "text": "You regain one expended use when you finish a Short Rest." },
        { "type": "recovery", "id": "rages-long-rest", "timing": "onLongRest", "resourceId": "rage", "on": "longRest", "amount": "all", "text": "You regain all expended uses when you finish a Long Rest." }
      ]
    },
    {
      "contentId": "52c00000-0000-4000-8000-000000000013",
      "revisionId": "52e00000-0000-4000-8000-000000000013",
      "schemaVersion": 3,
      "kind": "feature",
      "name": "Unarmored Defense",
      "rulesFamilies": ["srd-5.2.1"],
      "provenance": { "sourceId": "52500000-0000-4000-8000-000000000001", "page": { "start": 29 } },
      "status": "published",
      "summary": "While you aren't wearing any armor, your base Armor Class equals 10 plus your Dexterity and Constitution modifiers. You can use a Shield and still gain this benefit.",
      "effects": [
        { "type": "modifier", "id": "unarmored-defense-ac", "operation": "replace", "target": "armorClass", "value": "10 + DEX.MOD + CON.MOD", "text": "Applies while not wearing armor; armor is not modeled yet, so TomeStack assumes none." }
      ]
    },
    {
      "contentId": "52c00000-0000-4000-8000-000000000014",
      "revisionId": "52e00000-0000-4000-8000-000000000014",
      "schemaVersion": 3,
      "kind": "feature",
      "name": "Weapon Mastery",
      "rulesFamilies": ["srd-5.2.1"],
      "provenance": { "sourceId": "52500000-0000-4000-8000-000000000001", "page": { "start": 29 } },
      "status": "published",
      "summary": "Your training with weapons allows you to use the mastery properties of two kinds of Simple or Martial Melee weapons of your choice, such as Greataxes and Handaxes. Whenever you finish a Long Rest, you can practice weapon drills and change one of those weapon choices."
    },
    {
      "contentId": "52c00000-0000-4000-8000-000000000015",
      "revisionId": "52e00000-0000-4000-8000-000000000015",
      "schemaVersion": 3,
      "kind": "feature",
      "name": "Danger Sense",
      "rulesFamilies": ["srd-5.2.1"],
      "provenance": { "sourceId": "52500000-0000-4000-8000-000000000001", "page": { "start": 29 } },
      "status": "published",
      "summary": "You gain an uncanny sense of when things aren't as they should be, giving you an edge when you dodge perils. You have Advantage on Dexterity saving throws unless you have the Incapacitated condition."
    },
    {
      "contentId": "52c00000-0000-4000-8000-000000000016",
      "revisionId": "52e00000-0000-4000-8000-000000000016",
      "schemaVersion": 3,
      "kind": "feature",
      "name": "Reckless Attack",
      "rulesFamilies": ["srd-5.2.1"],
      "provenance": { "sourceId": "52500000-0000-4000-8000-000000000001", "page": { "start": 29 } },
      "status": "published",
      "summary": "You can throw aside all concern for defense to attack with increased ferocity. When you make your first attack roll on your turn, you can decide to attack recklessly. Doing so gives you Advantage on attack rolls using Strength until the start of your next turn, but attack rolls against you have Advantage during that time."
    },
