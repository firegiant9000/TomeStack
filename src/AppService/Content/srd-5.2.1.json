            { "contentId": "52c00000-0000-4000-8000-000000000021", "revisionId": "52e00000-0000-4000-8000-000000000021" },
            { "contentId": "52c00000-0000-4000-8000-000000000022", "revisionId": "52e00000-0000-4000-8000-000000000022" }
          ]
        },
        { "type": "grant", "id": "rage", "grant": "content", "level": 1, "content": { "contentId": "52c00000-0000-4000-8000-000000000012", "revisionId": "52e00000-0000-4000-8000-000000000012" } },
        { "type": "grant", "id": "unarmored-defense", "grant": "content", "level": 1, "content": { "contentId": "52c00000-0000-4000-8000-000000000013", "revisionId": "52e00000-0000-4000-8000-000000000013" } },
        { "type": "grant", "id": "weapon-mastery", "grant": "content", "level": 1, "content": { "contentId": "52c00000-0000-4000-8000-000000000014", "revisionId": "52e00000-0000-4000-8000-000000000014" } },
        { "type": "grant", "id": "danger-sense", "grant": "content", "level": 2, "content": { "contentId": "52c00000-0000-4000-8000-000000000015", "revisionId": "52e00000-0000-4000-8000-000000000015" } },
