    {
      "contentId": "52c00000-0000-4000-8000-000000000001",
      "revisionId": "52e00000-0000-4000-8000-000000000001",
      "schemaVersion": 3,
      "kind": "species",
      "name": "Dwarf",
      "rulesFamilies": ["srd-5.2.1"],
      "provenance": { "sourceId": "52500000-0000-4000-8000-000000000001", "page": { "start": 84 } },
      "status": "published",
      "summary": "Creature Type: Humanoid. Size: Medium (about 4-5 feet tall). Speed: 30 feet. Darkvision. You have Darkvision with a range of 120 feet. Dwarven Resilience. You have Resistance to Poison damage. You also have Advantage on saving throws you make to avoid or end the Poisoned condition.",
      "effects": [
        { "type": "modifier", "id": "dwarven-toughness", "operation": "bonus", "target": "hitPoints", "value": "LEVEL", "text": "Dwarven Toughness. Your Hit Point maximum increases by 1, and it increases by 1 again whenever you gain a level." },
        { "type": "resource", "id": "stonecunning", "automation": "assisted", "resourceId": "stonecunning", "label": "Stonecunning", "maximum": "PB", "text": "Stonecunning. As a Bonus Action, you gain Tremorsense with a range of 60 feet for 10 minutes. You must be on a stone surface or touching a stone surface to use this Tremorsense. You can use this Bonus Action a number of times equal to your Proficiency Bonus, and you regain all expended uses when you finish a Long Rest." },
        { "type": "recovery", "id": "stonecunning-rest", "timing": "onLongRest", "resourceId": "stonecunning", "on": "longRest", "amount": "all" }
      ]
    },
    {
