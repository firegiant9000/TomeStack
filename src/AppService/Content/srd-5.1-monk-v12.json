    {
      "contentId": "51c00000-0000-4000-8000-000000420101",
      "revisionId": "51e00000-0000-4000-8000-000012420101",
      "schemaVersion": 12,
      "kind": "feature",
      "name": "Unarmored Defense",
      "rulesFamilies": [
        "srd-5.1"
      ],
      "provenance": {
        "sourceId": "51500000-0000-4000-8000-000000000001",
        "page": {
          "start": 26
        }
      },
      "status": "published",
      "summary": "Beginning at 1st level, while you are wearing no armor and not wielding a shield, your AC equals 10 + your Dexterity modifier + your Wisdom modifier.\n\nTomeStack: applies only while no armor is worn and no shield is used (the Armor Class breakdown shows it as not used otherwise).",
      "effects": [
        {
          "type": "modifier",
          "id": "unarmored-defense-ac",
          "operation": "replace",
          "target": "armorClass",
          "value": "10 + DEX.MOD + WIS.MOD",
          "notWearing": [
            "shield"
          ],
          "text": "Applies only while no armor is worn and no shield is used."
        }
      ]
    },
    {
      "contentId": "51c00000-0000-4000-8000-000000420104",
      "revisionId": "51e00000-0000-4000-8000-000012420104",
      "schemaVersion": 12,
      "kind": "feature",
      "name": "Unarmored Movement",
      "rulesFamilies": [
        "srd-5.1"
      ],
      "provenance": {
        "sourceId": "51500000-0000-4000-8000-000000000001",
        "page": {
          "start": 27
        }
      },
      "status": "published",
      "summary": "Starting at 2nd level, your speed increases by 10 feet while you are not wearing armor or wielding a shield. This bonus increases when you reach certain monk levels, as shown in the Monk table.\n\nAt 9th level, you gain the ability to move along vertical surfaces and across liquids on your turn without falling during the move.\n\nTomeStack: the bonus from the Unarmored Movement column is added to your speed only while no armor is worn and no shield is used. Moving along vertical surfaces and across liquids is by hand.",
      "effects": [
        {
          "type": "modifier",
          "id": "unarmored-movement-speed",
          "operation": "bonus",
          "target": "speed",
          "value": "SCALE.unarmoredMovement",
          "notWearing": [
            "armor",
            "shield"
          ],
          "text": "Moving along vertical surfaces and across liquids is by hand."
        }
      ]
    },
    {
      "contentId": "51c00000-0000-4000-8000-000000420105",
      "revisionId": "51e00000-0000-4000-8000-000012420105",
      "schemaVersion": 12,
      "kind": "feature",
      "name": "Deflect Missiles",
      "rulesFamilies": [
        "srd-5.1"
      ],
      "provenance": {
        "sourceId": "51500000-0000-4000-8000-000000000001",
        "page": {
          "start": 27
        }
      },
      "status": "published",
      "summary": "Starting at 3rd level, you can use your reaction to deflect or catch the missile when you are hit by a ranged weapon attack. When you do so, the damage you take from the attack is reduced by 1d10 + your Dexterity modifier + your monk level.\n\nIf you reduce the damage to 0, you can catch the missile if it is small enough for you to hold in one hand and you have at least one hand free. If you catch a missile in this way, you can spend 1 ki point to make a ranged attack with the weapon or piece of ammunition you just caught, as part of the same reaction. You make this attack with proficiency, regardless of your weapon proficiencies, and the missile counts as a monk weapon for the attack, which has a normal range of 20 feet and a long range of 60 feet.\n\nTomeStack: the damage reduction is offered in the damage panel for a hit from an attack, and the throw spends 1 ki point. That the attack was a ranged weapon attack, catching the missile and the throw itself are by hand.",
      "effects": [
        {
          "type": "roll",
          "id": "deflect-missiles-throw",
          "rollId": "deflectMissilesThrow",
          "label": "Deflect Missiles: throw",
          "resourceId": "ki",
          "activation": "reaction",
          "resourceContent": "51c00000-0000-4000-8000-000000420103",
          "cost": "1"
        },
        {
          "type": "response",
          "id": "deflect-missiles",
          "responseId": "deflectMissiles",
          "label": "Deflect Missiles",
          "phase": "damageReduction",
          "trigger": {
            "from": "attack"
          },
          "dice": "1d10",
          "amount": "DEX.MOD + CLASS_LEVEL",
          "text": "Only a ranged weapon attack (by hand). You spend your reaction by hand; TomeStack does not track it."
        }
      ]
    },
    {
      "contentId": "51c00000-0000-4000-8000-000000420107",
      "revisionId": "51e00000-0000-4000-8000-000012420107",
      "schemaVersion": 12,
      "kind": "feature",
      "name": "Slow Fall",
      "rulesFamilies": [
        "srd-5.1"
      ],
      "provenance": {
        "sourceId": "51500000-0000-4000-8000-000000000001",
        "page": {
          "start": 27
        }
      },
      "status": "published",
      "summary": "Beginning at 4th level, you can use your reaction when you fall to reduce any falling damage you take by an amount equal to five times your monk level.\n\nTomeStack: the reduction is offered in the damage panel for fall damage. You spend your reaction by hand; TomeStack does not track it.",
      "effects": [
        {
          "type": "response",
          "id": "slow-fall",
          "responseId": "slowFall",
          "label": "Slow Fall",
          "phase": "damageReduction",
          "trigger": {
            "from": "fall"
          },
          "amount": "5 * CLASS_LEVEL",
          "text": "You spend your reaction by hand; TomeStack does not track it."
        }
      ]
    },
    {
      "contentId": "51c00000-0000-4000-8000-000000420111",
      "revisionId": "51e00000-0000-4000-8000-000012420111",
      "schemaVersion": 12,
      "kind": "feature",
      "name": "Evasion",
      "rulesFamilies": [
        "srd-5.1"
      ],
      "provenance": {
        "sourceId": "51500000-0000-4000-8000-000000000001",
        "page": {
          "start": 28
        }
      },
      "status": "published",
      "summary": "At 7th level, your instinctive agility lets you dodge out of the way of certain area effects, such as a blue dragon’s lightning breath or a fireball spell. When you are subjected to an effect that allows you to make a Dexterity saving throw to take only half damage, you instead take no damage if you succeed on the saving throw, and only half damage if you fail.",
      "effects": [
        {
          "type": "response",
          "id": "evasion-success",
          "responseId": "evasionSuccess",
          "label": "Evasion",
          "phase": "damageReduction",
          "trigger": {
            "from": "save",
            "ability": "dex",
            "result": "success"
          },
          "share": "all",
          "automatic": true,
          "supersedes": {
            "content": "51c00000-0000-4000-8000-000000410110",
            "responseId": "evasionSuccess"
          }
        },
        {
          "type": "response",
          "id": "evasion-failure",
          "responseId": "evasionFailure",
          "label": "Evasion",
          "phase": "damageReduction",
          "trigger": {
            "from": "save",
            "ability": "dex",
            "result": "failure"
          },
          "share": "half",
          "automatic": true,
          "supersedes": {
            "content": "51c00000-0000-4000-8000-000000410110",
            "responseId": "evasionFailure"
          }
        }
      ]
    },
    {
      "contentId": "51c00000-0000-4000-8000-000000420113",
      "revisionId": "51e00000-0000-4000-8000-000012420113",
      "schemaVersion": 12,
      "kind": "feature",
      "name": "Purity of Body",
      "rulesFamilies": [
        "srd-5.1"
      ],
      "provenance": {
        "sourceId": "51500000-0000-4000-8000-000000000001",
        "page": {
          "start": 28
        }
      },
      "status": "published",
      "summary": "At 10th level, your mastery of the ki flowing through you makes you immune to disease and poison.\n\nTomeStack: immunity to poison damage and to the poisoned condition is applied. Immunity to disease is by hand.",
      "effects": [
        {
          "type": "grant",
          "id": "purity-of-body-poison",
          "grant": "damageImmunity",
          "damageType": "Poison"
        },
        {
          "type": "grant",
          "id": "purity-of-body-poisoned",
          "grant": "conditionImmunity",
          "condition": "poisoned"
        }
      ]
