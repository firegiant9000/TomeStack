        "page": {
          "start": 24
        }
      },
      "status": "published",
      "summary": "When you are wielding a melee weapon in one hand and no other weapons, you gain a +2 bonus to damage rolls with that weapon.",
      "effects": []
    },
    {
      "contentId": "51c00000-0000-4000-8000-000000408603",
      "revisionId": "51e00000-0000-4000-8000-000000408603",
      "schemaVersion": 8,
      "kind": "feature",
      "name": "Fighting Style: Great Weapon Fighting",
      "rulesFamilies": [
        "srd-5.1"
      ],
      "provenance": {
        "sourceId": "51500000-0000-4000-8000-000000000001",
        "page": {
          "start": 24
        }
      },
      "status": "published",
      "summary": "When you roll a 1 or 2 on a damage die for an attack you make with a melee weapon that you are wielding with two hands, you can reroll the die and must use the new roll, even if the new roll is a 1 or a 2. The weapon must have the two-handed or versatile property for you to gain this benefit.",
      "effects": []
    },
    {
      "contentId": "51c00000-0000-4000-8000-000000408604",
      "revisionId": "51e00000-0000-4000-8000-000000408604",
      "schemaVersion": 8,
      "kind": "feature",
