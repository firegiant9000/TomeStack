        }
      ]
    },
    {
      "contentId": "51c00000-0000-4000-8000-000000408602",
      "revisionId": "51e00000-0000-4000-8000-000000408602",
      "schemaVersion": 8,
      "kind": "feature",
      "name": "Fighting Style: Dueling",
