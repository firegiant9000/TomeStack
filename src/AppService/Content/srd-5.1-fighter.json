    },
    {
      "contentId": "51c00000-0000-4000-8000-000000408502",
      "revisionId": "51e00000-0000-4000-8000-000000408502",
      "schemaVersion": 8,
      "kind": "feature",
      "name": "Remarkable Athlete",
      "rulesFamilies": [
        "srd-5.1"
      ],
      "provenance": {
        "sourceId": "51500000-0000-4000-8000-000000000001",
        "page": {
          "start": 25
        }
      },
      "status": "published",
      "summary": "Starting at 7th level, you can add half your proficiency bonus (round up) to any Strength, Dexterity, or Constitution check you make that doesn’t already use your proficiency bonus.\n\nIn addition, when you make a running long jump, the distance you can cover increases by a number of feet equal to your Strength modifier.",
      "effects": []
    },
