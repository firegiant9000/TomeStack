        "page": {
          "start": 24
        }
      },
      "status": "published",
      "summary": "You adopt a particular style of fighting as your specialty. Choose one of the following options. You can’t take a Fighting Style option more than once, even if you later get to choose again.",
      "effects": [
        {
          "type": "choice",
          "id": "fighting-style",
          "choiceId": "fighting-style",
          "count": 1,
          "text": "Fighting Style: You adopt a particular style of fighting as your specialty. Choose one of the following options. You can’t take a Fighting Style option more than once, even if you later get to choose again.",
