      ],
      "provenance": {
        "sourceId": "52500000-0000-4000-8000-000000000001",
        "page": {
          "start": 49
        }
      },
      "status": "published",
      "summary": "You attain the pinnacle of resilience in battle, giving you these benefits.\n\nDefy Death. You have Advantage on Death Saving Throws. Moreover, when you roll 18–20 on a Death Saving Throw, you gain the benefit of rolling a 20 on it.\n\nHeroic Rally. At the start of each of your turns, you regain Hit Points equal to 5 plus your Constitution modifier if you are Bloodied and have at least 1 Hit Point.",
      "effects": []
    },
