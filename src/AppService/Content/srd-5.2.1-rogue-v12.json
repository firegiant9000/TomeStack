          "label": "Uncanny Dodge",
          "phase": "damageReduction",
          "trigger": {
            "from": "attack"
          },
          "share": "half",
          "text": "Only an attacker you can see. You spend your reaction by hand; TomeStack does not track it."
        }
      ]
    },
    {
      "contentId": "52c00000-0000-4000-8000-000000410110",
      "revisionId": "52e00000-0000-4000-8000-000012410110",
      "schemaVersion": 12,
