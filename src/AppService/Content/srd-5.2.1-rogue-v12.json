    {
      "contentId": "52c00000-0000-4000-8000-000000410102",
      "revisionId": "52e00000-0000-4000-8000-000012410102",
      "schemaVersion": 12,
      "kind": "feature",
      "name": "Sneak Attack",
      "rulesFamilies": [
        "srd-5.2.1"
      ],
      "provenance": {
        "sourceId": "52500000-0000-4000-8000-000000000001",
        "page": {
          "start": 61,
          "end": 62
        }
      },
      "status": "published",
      "summary": "You know how to strike subtly and exploit a foe’s distraction. Once per turn, you can deal an extra 1d6 damage to one creature you hit with an attack roll if you have Advantage on the roll and the attack uses a Finesse or a Ranged weapon. The extra damage’s type is the same as the weapon’s type.\n\nYou don’t need Advantage on the attack roll if at least one of your allies is within 5 feet of the target, the ally doesn’t have the Incapacitated condition, and you don’t have Disadvantage on the attack roll.\n\nThe extra damage increases as you gain Rogue levels, as shown in the Sneak Attack column of the Rogue Features table.\n\nTomeStack: The Sneak Attack dice column on Play shows how many d6; roll and add them by hand, once per turn, when the conditions hold.\n\nTomeStack: Sneak Attack is offered as an extra rider on weapon attack damage rolls, once per turn, with the dice from the Sneak Attack column. Whether the weapon has Finesse or is Ranged, and whether you have Advantage or an ally is next to the target, is by hand.",
      "effects": [
        {
          "type": "attackRider",
          "id": "sneak-attack",
          "tags": [
            "weapon"
          ],
          "oncePerTurn": true,
          "automation": "assisted",
          "scaledDice": {
            "count": "SCALE.sneakAttack",
            "die": "6"
          },
          "text": "Only with a Finesse or Ranged weapon, and only with Advantage or an ally of the target within 5 feet (by hand)."
        }
      ]
    },
    {
      "contentId": "52c00000-0000-4000-8000-000000410106",
      "revisionId": "52e00000-0000-4000-8000-000012410106",
      "schemaVersion": 12,
      "kind": "feature",
      "name": "Steady Aim",
      "rulesFamilies": [
        "srd-5.2.1"
      ],
      "provenance": {
        "sourceId": "52500000-0000-4000-8000-000000000001",
        "page": {
          "start": 62
        }
      },
      "status": "published",
      "summary": "As a Bonus Action, you give yourself Advantage on your next attack roll on the current turn. You can use this feature only if you haven’t moved during this turn, and after you use it, your Speed is 0 until the end of the current turn.\n\nTomeStack: the toggle gives Advantage on your attack rolls and sets your Speed to 0 while it is on; that you haven’t moved this turn, that it is your next attack roll only, and turning it off at the end of the turn are by hand.",
      "effects": [
        {
          "type": "toggle",
          "id": "steady-aim",
          "toggleId": "steadyAim",
          "label": "Steady Aim",
          "activation": "bonusAction",
          "duration": "1"
        },
        {
          "type": "rollMode",
          "id": "steady-aim-attack",
          "target": "attack",
          "mode": "advantage",
          "tags": [
            "all"
          ],
          "toggle": "steadyAim"
        },
        {
          "type": "modifier",
          "id": "steady-aim-speed",
          "timing": "whileActive",
          "toggle": "steadyAim",
          "operation": "set",
          "target": "speed",
          "value": "0"
        }
      ]
    },
    {
