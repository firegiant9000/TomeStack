<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RulesCore\TomeStack.RulesCore.csproj" />
    <!-- Import contracts, the worker client and detection (ADR-009); the PDF parsing itself runs in the worker process. -->
    <ProjectReference Include="..\ImportWorker\TomeStack.ImportWorker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SRD packs (CC-BY-4.0; docs/licensing/srd-pack-review.md) are seeded into every data folder. -->
    <EmbeddedResource Include="Content\srd-5.1.json" LogicalName="TomeStack.Content.srd-5.1.json" />
    <EmbeddedResource Include="Content\srd-5.2.1.json" LogicalName="TomeStack.Content.srd-5.2.1.json" />
    <EmbeddedResource Include="Content\srd-5.1-spells.json" LogicalName="TomeStack.Content.srd-5.1-spells.json" />
    <EmbeddedResource Include="Content\srd-5.2.1-spells.json" LogicalName="TomeStack.Content.srd-5.2.1-spells.json" />
    <EmbeddedResource Include="Content\srd-5.1-equipment.json" LogicalName="TomeStack.Content.srd-5.1-equipment.json" />
    <EmbeddedResource Include="Content\srd-5.2.1-equipment.json" LogicalName="TomeStack.Content.srd-5.2.1-equipment.json" />
    <EmbeddedResource Include="Content\srd-5.1-classes.json" LogicalName="TomeStack.Content.srd-5.1-classes.json" />
    <EmbeddedResource Include="Content\srd-5.2.1-classes.json" LogicalName="TomeStack.Content.srd-5.2.1-classes.json" />
    <!-- The original test fixture pack is seeded only by development hosts and tests (TomeStackApp.Open devFixtures). -->
    <EmbeddedResource Include="..\..\tests\RulesFixtures\fixture-pack.json" LogicalName="TomeStack.FixturePack.json" />
    <EmbeddedResource Include="..\..\tests\RulesFixtures\fixture-pack-m2.json" LogicalName="TomeStack.FixturePackM2.json" />
    <EmbeddedResource Include="..\..\tests\RulesFixtures\fixture-pack-m2-spells.json" LogicalName="TomeStack.FixturePackM2Spells.json" />
    <EmbeddedResource Include="..\..\tests\RulesFixtures\fixture-pack-m2-combat.json" LogicalName="TomeStack.FixturePackM2Combat.json" />
    <EmbeddedResource Include="..\..\tests\RulesFixtures\fixture-pack-m3-effects.json" LogicalName="TomeStack.FixturePackM3Effects.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TomeStack.AppService.Tests" />
  </ItemGroup>

</Project>
