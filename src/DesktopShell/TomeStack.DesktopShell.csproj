<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- ADR-009: the Windows 10 TFM, like the import worker it ships (TomeStack.ImportWorker.Host.exe). The output folder
         keeps its name, so the gate, the scripts and CI find TomeStack.exe where they always did. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <OutputPath>bin\$(Configuration)\net10.0-windows\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <UseWPF>true</UseWPF>
    <AssemblyName>TomeStack</AssemblyName>
    <RootNamespace>TomeStack.DesktopShell</RootNamespace>
    <UiDist>$(MSBuildThisFileDirectory)..\Ui\dist\</UiDist>
    <!-- Velopack's install/uninstall hooks must run before WPF starts (ADR-008), so App has its own Main. -->
    <StartupObject>TomeStack.DesktopShell.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- License and third-party notices ship next to TomeStack.exe (ADR-008 R6). -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\..\LICENSE;$(MSBuildThisFileDirectory)..\..\NOTICE;$(MSBuildThisFileDirectory)..\..\ATTRIBUTION.md"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <!-- T5: the notices of the Rust crates in Velopack's Setup.exe and Update.exe (scripts/velopack-notices.mjs). -->
    <Content Include="$(MSBuildThisFileDirectory)..\..\docs\licensing\velopack-third-party-notices.md"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="THIRD-PARTY-NOTICES-Velopack.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppService\TomeStack.AppService.csproj" />
    <!-- The isolated PDF extraction process (ADR-009 (c)), copied next to TomeStack.exe. -->
    <ProjectReference Include="..\ImportWorker.Host\TomeStack.ImportWorker.Host.csproj" />
  </ItemGroup>

  <!-- The shell serves the prebuilt React bundle from its own folder via a WebView2 virtual host. -->
  <ItemGroup>
    <Content Include="$(UiDist)**\*" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RequireUiBundle" BeforeTargets="Build">
    <Error Condition="!Exists('$(UiDist)index.html')" Text="UI bundle not found at $(UiDist). Run 'npm ci' and 'npm run build' in src/Ui before building the desktop shell." />
  </Target>

</Project>
