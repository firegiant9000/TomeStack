<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Single source of the app and installer version. Velopack needs it to strictly increase; see ADR-008 "Versioning". -->
    <Version>0.4.0</Version>
    <Company>TomeStack</Company>
    <Product>TomeStack</Product>
  </PropertyGroup>
</Project>
