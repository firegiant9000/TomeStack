<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows TFM: the M4 acceptance runs imports in the real worker process (TomeStack.ImportWorker.Host.exe, ADR-009). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AppService\TomeStack.AppService.csproj" />
    <ProjectReference Include="..\..\src\ImportWorker\TomeStack.ImportWorker.csproj" />
    <!-- Copied next to the tests, which start it as a child process like the app does. -->
    <ProjectReference Include="..\..\src\ImportWorker.Host\TomeStack.ImportWorker.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\RulesFixtures\**\*.json" LinkBase="RulesFixtures" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\RulesFixtures\pdf\*.pdf" LinkBase="RulesFixtures\pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\schemas\*.json" LinkBase="schemas" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\AppService\Content\*.json" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\licensing\*.md" LinkBase="licensing" CopyToOutputDirectory="PreserveNewest" />
    <!-- M6 slice 3: the external sample extension, zipped by the tests as a user would (ADR-011). -->
    <None Include="..\..\examples\extensions\**\*" LinkBase="examples\extensions" CopyToOutputDirectory="PreserveNewest" />
    <!-- M6 slice 5: the author guides, whose tagged examples the tests follow. -->
    <None Include="..\..\docs\authoring\*.md" LinkBase="authoring" CopyToOutputDirectory="PreserveNewest" />
    <!-- M6 slice 4: golden export files (original fixture characters only). -->
    <None Include="Golden\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
