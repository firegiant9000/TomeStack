      "kind": "feature",
      "name": "Fixture Surge Form",
      "rulesFamilies": ["srd-5.2.1"],
      "provenance": { "sourceId": "6f0d5000-0000-4000-8000-000000000070", "page": { "start": 5 } },
      "status": "published",
      "summary": "A test form that costs 1 grit and raises Constitution by 2 (so the hit point maximum) while it lasts.",
      "effects": [
        { "type": "toggleGroup", "id": "forms-group", "groupId": "forms", "label": "Forms" },
        { "type": "toggle", "id": "surge", "toggleId": "surge", "label": "Surge form", "group": "forms", "cost": "1", "resourceId": "grit", "resourceContent": "6f0dc000-0000-4000-8000-000000000070" },
        { "type": "modifier", "id": "surge-con", "timing": "whileActive", "toggle": "surge", "operation": "bonus", "target": "ability.con.score", "value": "2" }
      ]
    },
    {
      "contentId": "6f0dc000-0000-4000-8000-000000000075",
      "revisionId": "6f0de000-0000-4000-8000-000000000075",
      "schemaVersion": 11,
      "kind": "feature",
      "name": "Fixture Rally",
      "rulesFamilies": ["srd-5.2.1"],
      "provenance": { "sourceId": "6f0d5000-0000-4000-8000-000000000070", "page": { "start": 6 } },
      "status": "published",
      "summary": "A test response: once per long rest, a hit that leaves you at a quarter of your maximum or less turns the surge form on and gives back 1 grit.",
      "effects": [
        { "type": "resource", "id": "rally-pool", "resourceId": "rally", "label": "Rally", "maximum": "1" },
        { "type": "recovery", "id": "rally-long", "timing": "onLongRest", "resourceId": "rally", "on": "longRest", "amount": "all" },
        {
          "type": "response", "id": "rally", "responseId": "rally", "label": "Rally", "phase": "threshold",
          "when": { "atOrBelow": "floor(HP.MAX / 4)" },
          "resourceId": "rally", "cost": "1",
          "outcomes": [
            { "kind": "toggleOn", "toggle": { "contentId": "6f0dc000-0000-4000-8000-000000000074", "toggleId": "surge" } },
            { "kind": "regain", "resourceId": "grit", "resourceContent": "6f0dc000-0000-4000-8000-000000000070", "amount": "1" }
          ]
        }
      ]
    },
