      "status": "published",
      "summary": "A test response: after a hit you survive, offer a counter roll of 1d8.",
      "effects": [
        { "type": "roll", "id": "counter", "rollId": "counter", "label": "Counter", "dice": "1d8" },
        {
          "type": "response", "id": "rebound", "responseId": "rebound", "label": "Rebound", "phase": "threshold",
          "when": { "survived": true },
          "outcomes": [
            { "kind": "offerRoll", "rollId": "counter" }
          ]
        }
      ]
    },
