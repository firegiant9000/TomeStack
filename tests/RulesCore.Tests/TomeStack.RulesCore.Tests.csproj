<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <!-- T3 property tests. 3.x supports xUnit v2 (xunit.extensibility.execution [2.4.1, 3.0.0)). -->
    <PackageReference Include="FsCheck.Xunit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RulesCore\TomeStack.RulesCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- local\ holds the owner's private files; tests read them from the source tree, so none is copied to bin. -->
    <None Include="..\RulesFixtures\**\*.json" Exclude="..\RulesFixtures\local\**" LinkBase="RulesFixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
